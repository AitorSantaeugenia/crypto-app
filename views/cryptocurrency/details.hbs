<div class="container">
  <nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
      <ul class="navbar-nav mr-auto breadcrumbs">
        <li class="nav-item">
          <a class="nav-link" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/cryptocurrency/-100">Cryptocurrencies</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" style="color: white !important;">{{crypto.name}}</a>
        </li>
      </ul>
    </div>
  </nav>

  <div class="crypto-details-container">
    <div class="crypto-header">
      <div class="crypto-title">
        {{#if crypto.logo}}
          <img src="{{crypto.logo}}" alt="{{crypto.name}}" class="crypto-logo">
        {{/if}}
        <h1>{{crypto.name}} <span class="symbol">({{crypto.symbol}})</span></h1>
        <span class="rank">Rank #{{crypto.rank}}</span>
      </div>
      <div class="price-container">
        <span class="price">{{formatCurrency crypto.price_usd}}</span>
        <span class="price-change {{#if (isPositive crypto.percent_change_24h)}}positive{{else}}negative{{/if}}">
          {{crypto.percent_change_24h}}% (24h)
        </span>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <h3>Market Cap</h3>
        <p>{{formatCurrency crypto.market_cap_usd}}</p>
      </div>
      <div class="stat-card">
        <h3>Volume (24h)</h3>
        <p>{{formatVolume crypto.volume24}}</p>
        <span class="sub-text">Volume 24h: {{formatVolume crypto.volume24a}}</span>
      </div>
      <div class="stat-card">
        <h3>Circulating Supply</h3>
        <p>{{formatNumber crypto.csupply}} {{crypto.symbol}}</p>
        <div class="supply-info">
          <span class="sub-text">Max Supply: {{#if crypto.msupply}}{{formatNumber crypto.msupply}}{{else}}∞{{/if}}</span>
        </div>
      </div>
      <div class="stat-card">
        <h3>Total Supply</h3>
        <p>{{formatNumber crypto.tsupply}} {{crypto.symbol}}</p>
      </div>
    </div>

    <div class="performance-grid">
      <div class="performance-card">
        <h3>Price Change</h3>
        <div class="performance-stats">
          <div class="stat-row">
            <span>1h</span>
            <span class="{{#if (isPositive crypto.percent_change_1h)}}positive{{else}}negative{{/if}}">
              {{crypto.percent_change_1h}}%
            </span>
          </div>
          <div class="stat-row">
            <span>24h</span>
            <span class="{{#if (isPositive crypto.percent_change_24h)}}positive{{else}}negative{{/if}}">
              {{crypto.percent_change_24h}}%
            </span>
          </div>
          <div class="stat-row">
            <span>7d</span>
            <span class="{{#if (isPositive crypto.percent_change_7d)}}positive{{else}}negative{{/if}}">
              {{crypto.percent_change_7d}}%
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="chart-container">
        <div class="chart-card">
            <h3>Price Change Overview</h3>
            <canvas id="priceChangeChart"></canvas>
        </div>
    </div>

    <div class="crypto-description">
      <h3>About {{crypto.name}}</h3>
      {{#if crypto.description}}
        <p>{{crypto.description}}</p>
      {{else}}
        <p class="no-description">No description available for {{crypto.name}}. This cryptocurrency is listed on CoinLore and actively traded.</p>
      {{/if}}
    </div>
  </div>
</div>

<script>
    // Convertir los datos de la crypto a un objeto JavaScript
    const cryptoData = {{{json crypto}}};
    
    // Mostrar los datos en la consola
    console.log('Cryptocurrency details:', cryptoData);

    document.addEventListener('DOMContentLoaded', function() {
        // Datos para el gráfico
        const ctx = document.getElementById('priceChangeChart').getContext('2d');
        
        // Crear el gráfico
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['1 Hour', '24 Hours', '7 Days'],
                datasets: [{
                    label: 'Price Change (%)',
                    data: [
                        parseFloat(cryptoData.percent_change_1h),
                        parseFloat(cryptoData.percent_change_24h),
                        parseFloat(cryptoData.percent_change_7d)
                    ],
                    backgroundColor: [
                        parseFloat(cryptoData.percent_change_1h) >= 0 ? 'rgba(16, 185, 129, 0.7)' : 'rgba(239, 68, 68, 0.7)',
                        parseFloat(cryptoData.percent_change_24h) >= 0 ? 'rgba(16, 185, 129, 0.7)' : 'rgba(239, 68, 68, 0.7)',
                        parseFloat(cryptoData.percent_change_7d) >= 0 ? 'rgba(16, 185, 129, 0.7)' : 'rgba(239, 68, 68, 0.7)'
                    ],
                    borderColor: [
                        parseFloat(cryptoData.percent_change_1h) >= 0 ? 'rgb(16, 185, 129)' : 'rgb(239, 68, 68)',
                        parseFloat(cryptoData.percent_change_24h) >= 0 ? 'rgb(16, 185, 129)' : 'rgb(239, 68, 68)',
                        parseFloat(cryptoData.percent_change_7d) >= 0 ? 'rgb(16, 185, 129)' : 'rgb(239, 68, 68)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                aspectRatio: 2,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return `${context.raw}%`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(0, 0, 0, 0.1)'
                        },
                        ticks: {
                            callback: function(value) {
                                return value + '%';
                            },
                            font: {
                                size: 11
                            }
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            font: {
                                size: 11
                            }
                        }
                    }
                }
            }
        });
    });
</script>

